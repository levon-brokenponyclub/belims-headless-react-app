# Belims Hardware Store - Environment Variables
# Copy this file to .env and fill in your actual values

# ===========================================
# GOOGLE GEMINI AI (Optional)
# ===========================================
# Get your API key from: https://aistudio.google.com/app/apikey
# Used for: Smart Recommendations, AI project analysis
VITE_GEMINI_API_KEY=your_google_gemini_api_key_here

# ===========================================
# WOOCOMMERCE INTEGRATION (Optional)
# ===========================================
# WordPress site URL (your headless WordPress installation)
VITE_WOO_SITE_URL=http://belims-headless.local

# WooCommerce REST API credentials
# Generate these in: WordPress Admin > WooCommerce > Settings > Advanced > REST API
VITE_WOO_CONSUMER_KEY=ck_your_consumer_key_here
VITE_WOO_CONSUMER_SECRET=cs_your_consumer_secret_here

# ===========================================
# ENVIRONMENT SETTINGS
# ===========================================
# Development mode (automatically set by Vite)
NODE_ENV=development

# ===========================================
# NOTES
# ===========================================
# - If API keys are missing, the app will use mock data
# - All variables must start with VITE_ to be accessible in browser
# - Never commit .env files with real API keys to git
# - For production, set these variables in Netlify Dashboard