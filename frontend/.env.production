# Production environment variables for GitHub Pages
# These will be set in GitHub repository secrets

# Note: For GitHub Pages deployment, sensitive keys should be stored in GitHub Secrets
# This file shows the structure but uses placeholder values
REACT_APP_GEMINI_API_KEY=your_production_gemini_api_key_here
REACT_APP_WOO_SITE_URL=https://your-production-site.com
REACT_APP_WOO_CONSUMER_KEY=your_production_consumer_key
REACT_APP_WOO_CONSUMER_SECRET=your_production_consumer_secret