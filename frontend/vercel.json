{
  "buildCommand": "npm ci --include=dev && npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/:path*",
      "has": [{ "type": "host", "value": "belims.vercel.app" }],
      "destination": "https://wordpress-1482444-6707114.cloudwaysapps.com/wp-json/:path*"
    },
    {
      "source": "/api/:path*",
      "destination": "https://cms.belims.co.za/wp-json/:path*"
    },
    {
      "source": "/:path*",
      "destination": "/app.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(images|brands)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/favicon.svg",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, stale-while-revalidate=86400"
        }
      ]
    }
  ]
}
